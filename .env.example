# ─────────────────────────────────────────────────────────────────────────────
# 22earn configuration — copy to `.env` and fill in. Never commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used for invite links, Stripe redirects, webhooks).
APP_URL=http://localhost:3000

# ── Docker Compose only (self-hosting) ──────────────────────────────────────
# DOMAIN=earn.example.com          # your domain, DNS A record → server IP (APP_URL=https://earn.example.com)
# POSTGRES_PASSWORD=change-me      # long random string (openssl rand -hex 24)

# Database. Leave empty for the embedded database (local dev, zero setup — stored in ./.data).
# Production: a real PostgreSQL URL, e.g. postgres://earn:password@db:5432/earn
DATABASE_URL=
# Set to false when using a transaction pooler (Neon/Supabase pooled URLs, pgbouncer).
# DATABASE_PREPARE=false

# Money. One currency for the whole platform (must match your Stripe balance / PayPal account).
CURRENCY=USD
APP_LOCALE=en-US

# Fake Stripe/PayPal calls to try the whole flow locally. MUST be false in production.
PAYOUTS_SIMULATE=true

# ── Stripe Connect (https://dashboard.stripe.com/apikeys) ───────────────────
STRIPE_SECRET_KEY=
# Webhook endpoint: $APP_URL/api/webhooks/stripe (events: account.updated, transfer.reversed,
# with "Listen to events on Connected accounts" enabled)
STRIPE_WEBHOOK_SECRET=
# "full" (creators in your platform's region) or "recipient" (cross-border payouts — see README)
STRIPE_SERVICE_AGREEMENT=full
# Pre-selected country in the "Connect with Stripe" form
STRIPE_DEFAULT_COUNTRY=US

# ── PayPal Payouts (https://developer.paypal.com/dashboard/applications) ────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
# Webhook endpoint: $APP_URL/api/webhooks/paypal → copy its Webhook ID here
PAYPAL_WEBHOOK_ID=

# ── Push notifications (posting reminders) — generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Reminders cron — any long random string (openssl rand -hex 32)
CRON_SECRET=
